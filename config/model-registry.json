{
  "meta": {
    "name": "KARTEX Model Registry Catalog",
    "phase": "E",
    "states": ["development", "candidate", "staging", "production", "retired"],
    "riskLevels": ["low", "medium", "high", "critical"],
    "governance": "No asset may be state=production without owner, evaluation.metrics, version, and lineage. Enforced by scripts/ops-model-registry-audit.mjs and lib/ai-platform/registry.ts.",
    "note": "KARTEX intelligence is currently DETERMINISTIC/HEURISTIC (no trained model artifacts) plus an embedding provider. This catalog governs them as production assets and tracks the path to trained/registered models."
  },
  "models": [
    {
      "key": "commerce-embedding",
      "name": "Commerce Embedding Generator",
      "purpose": "Vectorize products/queries for semantic retrieval",
      "owner": "discovery-platform",
      "type": "embedding",
      "implementation": "provider:openai(text-embedding-3-small,1536d) OR local-fallback(hash deterministic)",
      "inputSchema": { "text": "string" },
      "outputSchema": { "embedding": "float[1536]", "provider": "openai|local-fallback", "model": "string" },
      "trainingSource": "none (pretrained provider) / deterministic hash for fallback",
      "evaluation": { "metrics": ["search_quality_score", "embedding_freshness"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "high",
      "businessImpact": "Directly drives search & recommendations; fallback degrades quality",
      "lineage": { "consumes": ["products.title", "products.brand", "products.category"], "produces": ["product_embeddings", "qdrant:product_catalog_v1"] },
      "knownIssues": [
        "Embedding model/dimension mismatch vs infra/qdrant/collections.json (bge-small 384d)",
        "OpenAI vectors and hash-fallback vectors are NOT comparable; mixing corrupts similarity (no model-version isolation)"
      ]
    },
    {
      "key": "semantic-search",
      "name": "Hyperlocal Semantic Search",
      "purpose": "Hybrid retrieval (semantic + keyword + fuzzy) with geo + availability filters",
      "owner": "discovery-platform",
      "type": "retrieval-ranking",
      "implementation": "deterministic hybrid over embeddings + Postgres FTS",
      "inputSchema": { "query": "string", "filters": "object", "buyerLocation": "object?" },
      "outputSchema": { "results": "RankedProduct[]", "diagnostics": "object" },
      "trainingSource": "none (rule-based)",
      "evaluation": { "metrics": ["zero_result_rate", "search_quality_score", "ndcg@10"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "high",
      "businessImpact": "Primary product discovery path",
      "lineage": { "consumes": ["commerce-embedding", "products", "product_embeddings"], "produces": ["search results"] }
    },
    {
      "key": "hybrid-ranking",
      "name": "Adaptive Hybrid Ranking",
      "purpose": "Re-rank candidates with adaptive weights + diversity balancing",
      "owner": "discovery-platform",
      "type": "ranking",
      "implementation": "deterministic weighted scoring with degraded-mode fallback + internal driftScore",
      "inputSchema": { "candidates": "CandidateRankingInput[]", "profile": "PersonalizationProfile?", "control": "RankingControlPlane?" },
      "outputSchema": { "results": "RankedProduct[]", "diagnostics": { "driftScore": "number", "weights": "object" } },
      "trainingSource": "none (rule-based)",
      "evaluation": { "metrics": ["driftScore", "ndcg@10", "diversity"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "high",
      "businessImpact": "Determines product ordering shown to buyers",
      "lineage": { "consumes": ["semantic-search", "personalization-profile"], "produces": ["ranked results"] }
    },
    {
      "key": "recommendation-engine",
      "name": "Recommendation Engine",
      "purpose": "Related / personalized / trending / cross-category recommendations",
      "owner": "growth-platform",
      "type": "recommendation",
      "implementation": "deterministic diversity + freshness scoring",
      "inputSchema": { "surface": "RecommendationSurface", "products": "Product[]", "profile": "PersonalizationProfile?" },
      "outputSchema": { "recommendations": "ProductRecommendation[]", "diagnostics": "object" },
      "trainingSource": "none (rule-based)",
      "evaluation": { "metrics": ["recommendation_ctr", "diversity_sellers", "freshness"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "medium",
      "businessImpact": "Cross-sell / discovery uplift",
      "lineage": { "consumes": ["products", "personalization-profile"], "produces": ["recommendation bundles"] }
    },
    {
      "key": "personalization-profile",
      "name": "Buyer Personalization Profile",
      "purpose": "Derive buyer taste/intent signals with drift + recalibration flags",
      "owner": "growth-platform",
      "type": "personalization",
      "implementation": "deterministic behavioral aggregation; cold-start aware",
      "inputSchema": { "behaviorEvents": "BehaviorEvent[]" },
      "outputSchema": { "profile": { "fingerprint": "string", "drift": "object", "recalibrationNeeded": "boolean" } },
      "trainingSource": "behavioral events (no offline training)",
      "evaluation": { "metrics": ["coverage", "stale_preference_risk"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "medium",
      "businessImpact": "Personalizes ranking + recommendations; PII-sensitive",
      "lineage": { "consumes": ["behavior_events"], "produces": ["hybrid-ranking", "recommendation-engine"] }
    },
    {
      "key": "demand-forecasting",
      "name": "Demand / Executive Forecasting",
      "purpose": "Forecast demand & operational signals for executive intelligence",
      "owner": "data-platform",
      "type": "forecasting",
      "implementation": "deterministic statistical heuristic",
      "inputSchema": { "series": "number[]", "horizon": "number" },
      "outputSchema": { "forecast": "number[]", "confidence": "number" },
      "trainingSource": "historical aggregates",
      "evaluation": { "metrics": ["mape", "coverage"], "lastEvaluatedAt": null },
      "version": "0.9.0",
      "state": "staging",
      "risk": "medium",
      "businessImpact": "Planning / inventory guidance",
      "lineage": { "consumes": ["analytics aggregates"], "produces": ["executive dashboards"] }
    },
    {
      "key": "inventory-intelligence",
      "name": "Merchant / Inventory Intelligence",
      "purpose": "Restock + drift + seller operational guidance",
      "owner": "commerce-platform",
      "type": "operational-intelligence",
      "implementation": "deterministic heuristic over inventory + sales signals",
      "inputSchema": { "sellerId": "string", "window": "string" },
      "outputSchema": { "signals": "object" },
      "trainingSource": "none (rule-based)",
      "evaluation": { "metrics": ["inventory_drift", "stockout_precision"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "medium",
      "businessImpact": "Seller restock decisions",
      "lineage": { "consumes": ["orders", "products"], "produces": ["seller intelligence"] }
    },
    {
      "key": "knowledge-retrieval",
      "name": "Knowledge / RAG Retrieval",
      "purpose": "Retrieve knowledge chunks for taxonomy/policy/ops answers",
      "owner": "knowledge-platform",
      "type": "retrieval",
      "implementation": "Qdrant knowledge_chunks_v1 (pipeline not yet wired)",
      "inputSchema": { "query": "string", "filters": "object" },
      "outputSchema": { "chunks": "object[]" },
      "trainingSource": "ingested docs",
      "evaluation": { "metrics": ["retrieval_recall@k"], "lastEvaluatedAt": null },
      "version": "0.1.0",
      "state": "development",
      "risk": "low",
      "businessImpact": "Internal knowledge answers",
      "lineage": { "consumes": ["docs", "commerce-embedding"], "produces": ["RAG context"] }
    },
    {
      "key": "feedback-learning",
      "name": "Online Feedback Learning",
      "purpose": "Adjust recommendation/ranking from interaction signals; detect stale model",
      "owner": "discovery-platform",
      "type": "online-adaptation",
      "implementation": "deterministic signal aggregation + replay anomaly detection",
      "inputSchema": { "signals": "FeedbackSignal[]", "modelUpdatedAt": "string?" },
      "outputSchema": { "recommendationAdjustment": "number", "staleModelDetected": "boolean" },
      "trainingSource": "interaction telemetry",
      "evaluation": { "metrics": ["positive_rate", "replay_anomaly_rate"], "lastEvaluatedAt": null },
      "version": "1.0.0",
      "state": "production",
      "risk": "medium",
      "businessImpact": "Adapts discovery quality online",
      "lineage": { "consumes": ["interaction telemetry"], "produces": ["recommendation-engine", "hybrid-ranking"] }
    },
    {
      "key": "pricing-intelligence",
      "name": "Pricing Intelligence",
      "purpose": "Price guidance / competitiveness signals",
      "owner": "commerce-platform",
      "type": "pricing",
      "implementation": "heuristic (prototype)",
      "inputSchema": { "productId": "string", "marketSignals": "object" },
      "outputSchema": { "suggestedPriceMinor": "number", "confidence": "number" },
      "trainingSource": "none",
      "evaluation": { "metrics": ["margin_impact"], "lastEvaluatedAt": null },
      "version": "0.1.0",
      "state": "development",
      "risk": "high",
      "businessImpact": "Directly affects revenue/margins; must not auto-apply without approval",
      "lineage": { "consumes": ["orders", "products"], "produces": ["price suggestions"] }
    }
  ]
}
