(set-logic QF_LRA)
(declare-const confidence Real)
(declare-const trustScore Real)
(declare-const calibrationError Real)
(declare-const coverage Real)
(assert (and (>= confidence 0.0) (<= confidence 1.0)))
(assert (and (>= trustScore 0.0) (<= trustScore 1.0)))
(assert (= coverage (- 1.0 calibrationError)))
(assert (not (and (<= calibrationError 0.1) (< coverage 0.9))))
(check-sat)
