(set-logic QF_LRA)
(declare-const generality Real)
(declare-const adaptability Real)
(declare-const forecasting Real)
(declare-const transferability Real)
(declare-const robustness Real)
(declare-const coordination Real)
(declare-const exploration Real)
(declare-const failureResistance Real)
(define-fun bounded ((x Real)) Bool (and (>= x 0.0) (<= x 1.0)))
(assert (bounded generality))
(assert (bounded adaptability))
(assert (bounded forecasting))
(assert (bounded transferability))
(assert (bounded robustness))
(assert (bounded coordination))
(assert (bounded exploration))
(assert (bounded failureResistance))
(check-sat)
