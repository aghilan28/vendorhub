{
  "meta": {
    "name": "KARTEX Master Topic Taxonomy",
    "phase": "B",
    "namingConvention": "kartex.<domain>.<entity>.<event>  (DLQ: <topic>.dlq, replay: <topic>.replay)",
    "defaultReplicationFactor": 3,
    "localReplicationFactor": 1,
    "keyContract": "Every event MUST be keyed by its partition key for ordering + compaction. No event without an owner.",
    "schemaRegistry": "BACKWARD compatibility enforced; subject = <topic>-value"
  },
  "domains": {
    "orders": { "owner": "commerce-platform", "oncall": "commerce-oncall" },
    "payments": { "owner": "payments-platform", "oncall": "payments-oncall" },
    "inventory": { "owner": "catalog-platform", "oncall": "commerce-oncall" },
    "logistics": { "owner": "logistics-platform", "oncall": "logistics-oncall" },
    "notifications": { "owner": "engagement-platform", "oncall": "engagement-oncall" },
    "search": { "owner": "discovery-platform", "oncall": "ai-oncall" },
    "ai": { "owner": "intelligence-platform", "oncall": "ai-oncall" },
    "governance": { "owner": "trust-platform", "oncall": "trust-oncall" },
    "analytics": { "owner": "data-platform", "oncall": "data-oncall" },
    "knowledge": { "owner": "knowledge-platform", "oncall": "ai-oncall" },
    "realtime": { "owner": "experience-platform", "oncall": "experience-oncall" }
  },
  "topics": [
    {
      "name": "kartex.orders.order.lifecycle",
      "domain": "orders",
      "schemaSubject": "kartex.orders.order.lifecycle-value",
      "partitionKey": "orderId",
      "partitions": 12,
      "retentionMs": 2592000000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["logistics-dispatch", "notifications-dispatch", "analytics-ingest", "governance-fraud"],
      "dlq": "kartex.orders.order.lifecycle.dlq",
      "replay": "kartex.orders.order.lifecycle.replay",
      "replayPolicy": "from-offset|from-timestamp",
      "recoveryPolicy": "idempotent-consumer keyed by orderId+eventSequence",
      "mapsToPgQueues": ["commerce.checkout"]
    },
    {
      "name": "kartex.payments.transaction.events",
      "domain": "payments",
      "schemaSubject": "kartex.payments.transaction.events-value",
      "partitionKey": "paymentId",
      "partitions": 12,
      "retentionMs": 7776000000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["ledger-reconcile", "orders-finalize", "analytics-ingest", "governance-fraud"],
      "dlq": "kartex.payments.transaction.events.dlq",
      "replay": "kartex.payments.transaction.events.replay",
      "replayPolicy": "from-timestamp (bounded; financial replay requires dual-control approval)",
      "recoveryPolicy": "idempotent via webhook_ingestions(provider,event_id) + ledger idempotency keys",
      "mapsToPgQueues": ["commerce.reconciliation", "commerce.refunds", "commerce.payouts"]
    },
    {
      "name": "kartex.inventory.stock.changed",
      "domain": "inventory",
      "schemaSubject": "kartex.inventory.stock.changed-value",
      "partitionKey": "productId",
      "partitions": 24,
      "retentionMs": 604800000,
      "cleanupPolicy": "compact,delete",
      "consumerGroups": ["search-index", "flink-availability", "notifications-restock", "analytics-ingest"],
      "dlq": "kartex.inventory.stock.changed.dlq",
      "replay": "kartex.inventory.stock.changed.replay",
      "replayPolicy": "from-offset",
      "recoveryPolicy": "compacted latest-state per productId; rebuild from snapshot + replay",
      "mapsToPgQueues": ["realtime.invalidation"]
    },
    {
      "name": "kartex.logistics.delivery.tracking",
      "domain": "logistics",
      "schemaSubject": "kartex.logistics.delivery.tracking-value",
      "partitionKey": "deliveryId",
      "partitions": 12,
      "retentionMs": 1209600000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["flink-eta", "notifications-dispatch", "analytics-ingest"],
      "dlq": "kartex.logistics.delivery.tracking.dlq",
      "replay": "kartex.logistics.delivery.tracking.replay",
      "replayPolicy": "from-timestamp",
      "recoveryPolicy": "idempotent keyed by deliveryId+trackingSeq",
      "mapsToPgQueues": ["logistics.eta", "logistics.dispatch", "logistics.tracking-replay", "logistics.routing", "logistics.sla", "logistics.congestion"]
    },
    {
      "name": "kartex.notifications.dispatch.requested",
      "domain": "notifications",
      "schemaSubject": "kartex.notifications.dispatch.requested-value",
      "partitionKey": "recipientId",
      "partitions": 12,
      "retentionMs": 259200000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["notify-email", "notify-push", "notify-sms", "notify-digest"],
      "dlq": "kartex.notifications.dispatch.requested.dlq",
      "replay": "kartex.notifications.dispatch.requested.replay",
      "replayPolicy": "from-offset (suppress already-delivered via dedupe store)",
      "recoveryPolicy": "idempotent per (recipientId,notificationId,channel)",
      "mapsToPgQueues": ["notifications.dispatch", "notifications.email", "notifications.push", "notifications.sms", "notifications.digest"]
    },
    {
      "name": "kartex.search.catalog.indexing",
      "domain": "search",
      "schemaSubject": "kartex.search.catalog.indexing-value",
      "partitionKey": "productId",
      "partitions": 12,
      "retentionMs": 604800000,
      "cleanupPolicy": "compact,delete",
      "consumerGroups": ["qdrant-upsert", "pg-fts-index"],
      "dlq": "kartex.search.catalog.indexing.dlq",
      "replay": "kartex.search.catalog.indexing.replay",
      "replayPolicy": "from-offset (full reindex supported)",
      "recoveryPolicy": "rebuild collection from catalog snapshot",
      "mapsToPgQueues": ["ai.semantic-index"]
    },
    {
      "name": "kartex.ai.embedding.requested",
      "domain": "ai",
      "schemaSubject": "kartex.ai.embedding.requested-value",
      "partitionKey": "productId",
      "partitions": 8,
      "retentionMs": 604800000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["embedding-worker", "qdrant-upsert"],
      "dlq": "kartex.ai.embedding.requested.dlq",
      "replay": "kartex.ai.embedding.requested.replay",
      "replayPolicy": "from-offset",
      "recoveryPolicy": "idempotent per (entityType,entityId,modelVersion)",
      "mapsToPgQueues": ["ai.embeddings", "ai.embeddings-scheduled", "ai.recommendations", "ai.ranking", "ai.personalization", "ai.observability"]
    },
    {
      "name": "kartex.governance.risk.signals",
      "domain": "governance",
      "schemaSubject": "kartex.governance.risk.signals-value",
      "partitionKey": "subjectId",
      "partitions": 8,
      "retentionMs": 7776000000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["fraud-scan", "moderation-scan", "trust-recalc", "dispute-analyze", "audit-sink"],
      "dlq": "kartex.governance.risk.signals.dlq",
      "replay": "kartex.governance.risk.signals.replay",
      "replayPolicy": "from-timestamp (audited)",
      "recoveryPolicy": "append-only audit; idempotent per signalId",
      "mapsToPgQueues": ["governance.fraud", "governance.moderation", "governance.trust", "governance.disputes"]
    },
    {
      "name": "kartex.analytics.telemetry.stream",
      "domain": "analytics",
      "schemaSubject": "kartex.analytics.telemetry.stream-value",
      "partitionKey": "sessionId",
      "partitions": 24,
      "retentionMs": 1209600000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["flink-metrics", "warehouse-sink"],
      "dlq": "kartex.analytics.telemetry.stream.dlq",
      "replay": "kartex.analytics.telemetry.stream.replay",
      "replayPolicy": "from-timestamp",
      "recoveryPolicy": "at-least-once to warehouse; dedupe on eventId",
      "mapsToPgQueues": ["analytics.operational", "analytics.seller-aggregation", "analytics.forecasting", "analytics.admin"]
    },
    {
      "name": "kartex.knowledge.graph.mutations",
      "domain": "knowledge",
      "schemaSubject": "kartex.knowledge.graph.mutations-value",
      "partitionKey": "entityId",
      "partitions": 6,
      "retentionMs": 7776000000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["neo4j-projector", "audit-sink"],
      "dlq": "kartex.knowledge.graph.mutations.dlq",
      "replay": "kartex.knowledge.graph.mutations.replay",
      "replayPolicy": "from-offset (graph rebuildable from log)",
      "recoveryPolicy": "graph is a projection; rebuild by replaying mutations into Neo4j",
      "mapsToPgQueues": []
    },
    {
      "name": "kartex.realtime.invalidation",
      "domain": "realtime",
      "schemaSubject": "kartex.realtime.invalidation-value",
      "partitionKey": "channel",
      "partitions": 12,
      "retentionMs": 86400000,
      "cleanupPolicy": "delete",
      "consumerGroups": ["edge-fanout"],
      "dlq": "kartex.realtime.invalidation.dlq",
      "replay": "kartex.realtime.invalidation.replay",
      "replayPolicy": "none (ephemeral; safe to drop)",
      "recoveryPolicy": "best-effort; clients re-sync on reconnect",
      "mapsToPgQueues": ["realtime.invalidation"]
    }
  ]
}
