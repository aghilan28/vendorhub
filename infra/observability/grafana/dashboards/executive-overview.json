{
  "uid": "kartex-exec",
  "title": "KARTEX — Executive Overview",
  "tags": ["kartex", "executive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Orders created (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(kartex_orders_created_total[1h]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Checkout success rate (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.85 }, { "color": "green", "value": 0.95 }] } } },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(kartex_checkout_success_total[1h])) / clamp_min(sum(increase(kartex_checkout_attempts_total[1h])),1)" }]
    },
    {
      "id": 3, "type": "stat", "title": "Payment success rate (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.98 }] } } },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(kartex_payments_authorized_total[1h])) / clamp_min(sum(increase(kartex_payments_authorized_total[1h]))+sum(increase(kartex_payments_failed_total[1h])),1)" }]
    },
    {
      "id": 4, "type": "stat", "title": "API 5xx rate (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.02 }, { "color": "red", "value": 0.05 }] } } },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(kartex_api_errors_total[5m])) / clamp_min(sum(rate(kartex_api_requests_total[5m])),1)" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Orders: created vs completed vs failed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kartex_orders_created_total[5m]))", "legendFormat": "created" },
        { "refId": "B", "expr": "sum(rate(kartex_orders_completed_total[5m]))", "legendFormat": "completed" },
        { "refId": "C", "expr": "sum(rate(kartex_orders_failed_total[5m]))", "legendFormat": "failed" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Runtime reachability",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "refId": "A", "expr": "kartex_runtime_up", "legendFormat": "{{runtime}}" }]
    }
  ]
}
