NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://vendorhub.vercel.app

NEXT_PUBLIC_SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
NEXT_PUBLIC_SUPABASE_VENDOR_ASSETS_BUCKET=vendor-assets
NEXT_PUBLIC_SUPABASE_PROFILE_IMAGES_BUCKET=profile-images

OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_ID=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@vendorhub.in

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=


# ---------------------------------------------------------------------------
# Phase B — Distributed Runtime (ALL OPTIONAL; disabled unless *_ENABLED=true).
# When a runtime is disabled or unreachable, the app falls back to its existing
# Postgres / in-process implementation. Adapters in lib/runtime/* activate the
# moment the matching optional package is installed AND the flag is set to true.
#
# Optional packages (install only the runtimes you enable):
#   npm install ioredis kafkajs neo4j-driver        # qdrant + flink use REST (no package)
# ---------------------------------------------------------------------------

# Redis (cache / locks / distributed rate-limit / idempotency)
RUNTIME_REDIS_ENABLED=false
REDIS_URL=
REDIS_KEY_PREFIX=kartex
REDIS_CONNECT_TIMEOUT_MS=2000

# Kafka (event fabric)
RUNTIME_KAFKA_ENABLED=false
KAFKA_BROKERS=                       # comma-separated host:port list
KAFKA_CLIENT_ID=kartex-app
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=                # e.g. plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=

# Neo4j (relationship runtime)
RUNTIME_NEO4J_ENABLED=false
NEO4J_URL=                           # e.g. neo4j+s://<id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant (vector runtime)
RUNTIME_QDRANT_ENABLED=false
QDRANT_URL=                          # e.g. https://<id>.qdrant.io:6333
QDRANT_API_KEY=

# Flink (stream runtime) — REST endpoint for health/job status only
RUNTIME_FLINK_ENABLED=false
FLINK_REST_URL=                      # e.g. http://flink-jobmanager:8081


# ---------------------------------------------------------------------------
# Phase C — Observability (all OPTIONAL; telemetry never blocks request paths).
# ---------------------------------------------------------------------------
# OpenTelemetry trace export (push). When enabled, spans are exported as OTLP-JSON
# to the collector (infra/observability/otel-collector.yaml). No package required.
RUNTIME_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=          # e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=           # optional: key=value,key2=value2 (managed APM auth)
OTEL_SERVICE_NAME=vendorhub-web

# Prometheus scrape endpoint protection. If set, GET /api/metrics requires
# Authorization: Bearer <token>. Leave blank to expose unauthenticated (NOT for prod).
METRICS_AUTH_TOKEN=

# Structured-log/error forwarding sink (already honored by lib/observability/core.ts).
OBSERVABILITY_INGEST_URL=             # OTLP/log collector or APM ingest URL
