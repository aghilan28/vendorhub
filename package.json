{
  "name": "vendorhub",
  "version": "0.1.0",
  "private": true,
  "description": "VendorHub hyperlocal multi-vendor commerce operating system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/integration",
    "test:reliability": "vitest run tests/reliability",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "reliability:load": "node scripts/reliability-load.mjs",
    "stabilization:s1-load": "node scripts/stabilization-s1-load.mjs",
    "phase31:load": "node scripts/phase31-distributed-async-load.mjs",
    "phase32:load": "node scripts/phase32-live-logistics-load.mjs",
    "phase36:load": "node scripts/phase36-global-infrastructure-load.mjs",
    "phase37:load": "node scripts/phase37-developer-platform-load.mjs",
    "phase38:load": "node scripts/phase38-autonomous-operations-load.mjs",
    "phase39:load": "node scripts/phase39-executive-intelligence-load.mjs",
    "ops:load-simulate": "npm run reliability:load && npm run phase31:load && npm run phase32:load && npm run phase39:load",
    "ops:env-audit": "node scripts/ops-env-audit.mjs",
    "ops:secret-scan": "node scripts/ops-secret-scan.mjs",
    "ops:migration-audit": "node scripts/ops-migration-audit.mjs",
    "ops:release-manifest": "node scripts/ops-release-manifest.mjs",
    "ops:backup-plan": "node scripts/ops-backup-plan.mjs",
    "ops:smoke": "node scripts/ops-smoke.mjs",
    "pp1:certify": "npx --yes tsx scripts/pp1-taxonomy-certify.ts",
    "pp2:certify": "npx --yes tsx scripts/pp2-brand-certify.ts",
    "pp3:certify": "npx --yes tsx scripts/pp3-product-certify.ts",
    "ops:preflight": "npm run ops:env-audit && npm run ops:secret-scan && npm run ops:migration-audit && npm run ops:release-manifest && npm run ops:backup-plan",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run ops:preflight && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.54.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "caniuse-lite": "^1.0.30001793",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "next": "^15.5.7",
    "razorpay": "^2.9.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.7",
    "prettier": "^3.8.3",
    "supabase": "^2.101.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.7"
  }
}
